{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"inputs": [
		{
			"id": "buildConfig",
			"type": "pickString",
			"description": "Select a build configuration",
			"options": [
				"Release",
				"Debug"
			],
			"default": "Debug"
		}
	],
	"tasks": [
		{
			"label": "Build",
			"command": "dotnet",
			"type": "shell",
			"args": [
				"build",
				"-c",
				"${input:buildConfig}",
			],
			"group": "build",
			"presentation": {
				// "reveal": "silent"
			},
			"problemMatcher": "$msCompile"
		}
	]
}
